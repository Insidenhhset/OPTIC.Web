@model List<Optic.Identity.Models.Navigation.ApplicationMenuItem>

<div data-ajax-page data-page-title="Identity Dashboard">

    <!-- Dashboard Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Identity Management</h2>
            <p class="text-secondary mb-0">
                Manage users, roles, permissions and application access.
            </p>
        </div>

        <div class="text-secondary">
            <i class="bi bi-shield-lock me-1"></i>
            Identity Module
        </div>
    </div>

    <!-- Dashboard Cards -->
    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-grid fs-1 text-secondary"></i>
            <h5 class="mt-3">No modules available</h5>
            <p class="text-secondary">
                You currently don't have access to any Identity features.
            </p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var menu in Model)
            {
                <div class="col-12 col-sm-6 col-xl-4">
                    <a href="@menu.Route"
                       data-ajax-nav
                       class="text-decoration-none text-reset">

                        <div class="card h-100 border-0 shadow-sm identity-dashboard-card">
                            <div class="card-body p-4">

                                <div class="d-flex align-items-center justify-content-between mb-4">
                                    <div class="identity-card-icon">
                                        <i class="@(string.IsNullOrWhiteSpace(menu.Icon)
                                                                                       ? "bi bi-grid"
                                                                                       : menu.Icon)"></i>
                                                                                            </div>

                                    <i class="bi bi-arrow-up-right text-secondary fs-5"></i>
                                </div>

                                <h5 class="fw-semibold mb-2">
                                    @menu.MenuName
                                </h5>

                                <p class="text-secondary small mb-0">
                                    @(string.IsNullOrWhiteSpace(menu.Description)
                                                                ? "Manage " + menu.MenuName
                                                                : menu.Description)
                        </p>

                            </div>
                        </div>
                    </a>
                </div>
                }
        </div>
    }

</div>

<style>
    .identity-dashboard-card {
        border-radius: 14px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .identity-dashboard-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.09) !important;
        }

    .identity-card-icon {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: var(--bs-primary-bg-subtle);
        color: var(--bs-primary);
        font-size: 1.5rem;
    }
</style>