<div class="container-fluid"
     data-ajax-page
     data-page-title="Application Role Mapping">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">Application Role Mapping</h4>
            <p class="text-muted mb-0">
                Configure which roles are available in each application.
            </p>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">

            <div class="row align-items-end g-3">

                <div class="col-md-5">
                    <label for="applicationSelect" class="form-label fw-semibold">
                        Select Application
                    </label>

                    <select id="applicationSelect" class="form-select">
                        <option value="">Loading applications...</option>
                    </select>
                </div>

                <div class="col-md-7">
                    <div id="selectedApplicationInfo" class="text-muted small">
                        Select an application to manage its role mappings.
                    </div>
                </div>

            </div>

        </div>
    </div>

    <div id="applicationRoleMappingsContainer">

        <div class="card border-0 shadow-sm">

            <div class="card-header bg-white py-3">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                    <div>
                        <h5 class="mb-1">Available Roles</h5>
                        <small class="text-muted">
                            Manage role availability for the selected application.
                        </small>
                    </div>

                    <span class="badge bg-primary" id="mappedRoleCount">
                        0 Mapped
                    </span>

                </div>
            </div>

            <div class="card-body">

                <div class="row g-3 mb-3">

                    <div class="col-md-6">
                        <input type="search"
                               id="mappingSearch"
                               class="form-control"
                               placeholder="Search by role code or name..." />
                    </div>

                    <div class="col-md-3">
                        <select id="mappingStatusFilter" class="form-select">
                            <option value="all" selected>All Roles</option>
                            <option value="mapped">Mapped</option>
                            <option value="unmapped">Unmapped</option>
                            <option value="inactive">Inactive Mapping</option>
                        </select>
                    </div>

                </div>

                <div class="table-responsive">

                    <table class="table table-hover align-middle" id="applicationRoleMappingTable">

                        <thead class="table-light">
                            <tr>
                                <th>Role Code</th>
                                <th>Role Name</th>
                                <th>Description</th>
                                <th>Role Status</th>
                                <th>Mapping Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody id="applicationRoleMappingTableBody">
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    Select an application to view roles.
                                </td>
                            </tr>
                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>




    
<!-- Application Role Mapping Confirmation Modal -->
<div class="modal fade" id="mappingConfirmationModal"
     tabindex="-1" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow">

            <div class="modal-body text-center p-4">

                <div class="fs-1 mb-2" id="mappingConfirmationIcon">
                    <i class="bi bi-exclamation-circle text-primary"></i>
                </div>

                <h5 class="fw-semibold mb-2"
                    id="mappingConfirmationModalLabel">
                    Map Role?
                </h5>

                <p class="text-secondary mb-0"
                   id="mappingConfirmationMessage">
                    Map this role to the selected application?
                </p>

            </div>

            <div class="modal-footer justify-content-center border-0 pt-0">

                <button type="button"
                        class="btn btn-light"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-primary"
                        id="confirmMappingActionBtn">
                    Map Role
                </button>

            </div>

        </div>
    </div>
</div>

</div>