@model List<Optic.Identity.Models.RoleManagement.Role>

<div data-ajax-page data-page-title="Role Master">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-semibold mb-1">Role Master</h4>
            <p class="text-muted mb-0">
                Manage roles available in the OPTIC Identity system.
            </p>
        </div>

        <button type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#createRoleModal">
            <i class="bi bi-plus-lg me-1"></i>
            Add Role
        </button>
    </div>
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <input type="search"
                   id="roleSearch"
                   class="form-control"
                   placeholder="Search by role code, name or description..." />
        </div>

        <div class="col-md-3">
            <select id="roleStatusFilter" class="form-select">
                <option value="active" selected>Active</option>
                <option value="inactive">Inactive</option>
            </select>
        </div>
    </div>
    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle" id="roleTable">
                    <thead>
                        <tr>
                            <th>Role Code</th>
                            <th>Role Name</th>
                            <th>Description</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody id="roleTableBody">
                        @if (Model != null && Model.Any())
                        {
                            foreach (var role in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@role.RoleCode</td>
                                    <td>@role.RoleName</td>
                                    <td>@(string.IsNullOrWhiteSpace(role.Description) ? "-" : role.Description)</td>
                                    <td>
                                        @if (role.IsSystem)
                                        {
                                            <span class="badge bg-info-subtle text-info">System</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary">Custom</span>
                                        }
                                    </td>
                                    <td>
                                        @if (role.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary edit-role-btn"
                                                data-id="@role.Id">
                                            <i class="bi bi-pencil-square"></i> Edit
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    No roles found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>

    <div class="modal fade" id="createRoleModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">

                <div class="modal-header">
                    <h5 class="modal-title fw-semibold">Create Role</h5>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>

                <form id="createRoleForm"
                      action="/IdentityRoles/Create"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="modal-body">

                        <div class="mb-3">
                            <label for="RoleCode" class="form-label">
                                Role Code <span class="text-danger">*</span>
                            </label>
                            <input type="text"
                                   class="form-control"
                                   id="RoleCode"
                                   name="RoleCode"
                                   maxlength="50"
                                   placeholder="e.g. BRANCH_MAKER"
                                   required />
                            <div class="form-text">
                                Use uppercase letters, numbers and underscores.
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="RoleName" class="form-label">
                                Role Name <span class="text-danger">*</span>
                            </label>
                            <input type="text"
                                   class="form-control"
                                   id="RoleName"
                                   name="RoleName"
                                   maxlength="100"
                                   placeholder="Enter role name"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label for="Description" class="form-label">
                                Description
                            </label>
                            <textarea class="form-control"
                                      id="Description"
                                      name="Description"
                                      rows="3"
                                      maxlength="500"
                                      placeholder="Enter role description"></textarea>
                        </div>

                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="IsSystem"
                                   name="IsSystem"
                                   value="true" />

                            <label class="form-check-label" for="IsSystem">
                                System Role
                            </label>

                            <div class="form-text">
                                Enable this option to mark the role as a system-defined role.
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-light"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>
                            Create Role
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>

    <div class="modal fade" id="editRoleModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">

                <div class="modal-header">
                    <h5 class="modal-title fw-semibold">Edit Role</h5>
                    <button type="button" class="btn-close"
                            data-bs-dismiss="modal"></button>
                </div>

                <form id="editRoleForm">
                    @Html.AntiForgeryToken()

                    <div class="modal-body">

                        <input type="hidden" id="editRoleId" name="Id" />

                        <div class="mb-3">
                            <label class="form-label">Role Code</label>
                            <input type="text"
                                   id="editRoleCode"
                                   class="form-control"
                                   readonly />
                        </div>

                        <div class="mb-3">
                            <label for="editRoleName" class="form-label">
                                Role Name
                            </label>
                            <input type="text"
                                   id="editRoleName"
                                   name="RoleName"
                                   class="form-control"
                                   maxlength="100"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label for="editRoleDescription" class="form-label">
                                Description
                            </label>
                            <textarea id="editRoleDescription"
                                      name="Description"
                                      class="form-control"
                                      rows="3"
                                      maxlength="500"></textarea>
                        </div>

                        <div class="mb-0">
                            <div class="mb-0">
                                <label class="form-label">Role Type</label>
                                <div id="editRoleType"></div>
                            </div>
                        </div>

                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-light"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit"
                                class="btn btn-primary">
                            <span class="btn-text">Update Role</span>
                            <span class="spinner-border spinner-border-sm d-none"
                                  role="status"></span>
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>

    <!-- Activate / Deactivate Role Confirmation Modal -->
    <div class="modal fade" id="roleStatusModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow">
                <div class="modal-body text-center p-4">

                    <div class="fs-1 mb-3" id="roleStatusIcon">
                        <i class="bi bi-exclamation-circle text-danger"></i>
                    </div>

                    <h5 class="fw-semibold" id="roleStatusTitle">
                        Deactivate Role?
                    </h5>

                    <p class="text-secondary mb-0" id="roleStatusMessage">
                        Are you sure you want to deactivate this role?
                    </p>
                </div>

                <div class="modal-footer justify-content-center border-0 pt-0">
                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="button"
                            class="btn btn-danger"
                            id="btnConfirmRoleStatus">
                        Deactivate
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>