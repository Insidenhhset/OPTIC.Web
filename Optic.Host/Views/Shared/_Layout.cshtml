@using System.Security.Claims

@{
      var avatarUrl = User.FindFirst("AvatarUrl")?.Value;

    var fullName = $"{User.FindFirst(ClaimTypes.GivenName)?.Value} {User.FindFirst(ClaimTypes.Surname)?.Value}".Trim();

    if (string.IsNullOrWhiteSpace(fullName))
        fullName = User.Identity?.Name ?? "User";

    var username = User.Identity?.Name ?? "User";

    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);

    var applications = new List<Optic.Identity.Models.Navigation.ApplicationNavigationItem>();
    var identityMenus = new List<Optic.Identity.Models.Navigation.ApplicationMenuItem>();

    if (int.TryParse(userId, out var parsedUserId))
    {
        var navigationService = Context.RequestServices
            .GetRequiredService<
                Optic.Identity.Services.Interfaces.IApplicationNavigationService>();

        applications = await navigationService.GetAccessibleApplicationsAsync(parsedUserId);

        var identityApplication = applications.FirstOrDefault(
        x => x.ApplicationCode.Equals(
            "IDENTITY",
            StringComparison.OrdinalIgnoreCase));

        if (identityApplication != null)
        {
            identityMenus = await navigationService.GetAccessibleMenusAsync(
                parsedUserId,
                identityApplication.Id);

        }
    }

    var expiryClaim =
     User.FindFirst("optic:session_expires_at")?.Value;

    var hasSessionExpiry = DateTimeOffset.TryParse(
        expiryClaim,
        out var expiry);

    var expiryText = hasSessionExpiry
        ? expiry.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
        : "Unavailable";

    var sessionExpiryUnixMs = hasSessionExpiry
        ? expiry.ToUnixTimeMilliseconds()
        : 0;

    var serverNowUnixMs =
        DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();

    var pageTitle =
        ViewData["Title"]?.ToString() ?? "OPTIC";

    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@pageTitle | OPTIC</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        :root {
            --sidebar-width: 255px;
            --sidebar-bg: #111c36;
            --primary: #172554;
            --body-bg: #f4f6fa;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: var(--body-bg);
            font-family: Arial, sans-serif;
            color: #1e293b;
        }

        .optic-session-countdown {
    font-size: 12px;
    font-weight: 600;
    padding: 9px 12px;
    border-radius: 20px;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
}

.optic-session-countdown.bg-danger {
    color: white !important;
}

        /* Sidebar */


        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: var(--sidebar-width);
            height: 100vh;
            background: var(--sidebar-bg);
            color: white;
            z-index: 1030;
            transition: transform .25s ease;
        }

        .sidebar-brand {
            height: 70px;
            display: flex;
            align-items: center;
            padding: 0 25px;
            border-bottom: 1px solid rgba(255,255,255,.1);
        }

        .brand-name {
            font-size: 25px;
            font-weight: 700;
            letter-spacing: 3px;
        }

        .brand-subtitle {
            font-size: 9px;
            letter-spacing: 1px;
            color: #94a3b8;
            margin-left: 9px;
        }

        .sidebar-menu {
            padding: 25px 12px;
        }

        .menu-label {
            color: #718096;
            font-size: 11px;
            font-weight: 600;
            padding: 0 13px;
            margin-bottom: 12px;
            text-transform: uppercase;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 13px;
            padding: 12px 14px;
            color: #cbd5e1;
            text-decoration: none;
            border-radius: 7px;
            margin-bottom: 6px;
            font-size: 14px;
            transition: .2s;
        }

            .sidebar-link:hover,
            .sidebar-link.active {
                background: #26385e;
                color: white;
            }

            .sidebar-link i {
                font-size: 18px;
            }

        /* Main area */

        .main-wrapper {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            transition: margin-left .25s ease;
        }

        .top-header {
            height: 70px;
            background: white;
            border-bottom: 1px solid #e5e7eb;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
            position: sticky;
            top: 0;
            z-index: 1020;
        }

        .sidebar-toggle {
            border: none;
            background: transparent;
            font-size: 24px;
            color: #334155;
            padding: 3px 8px;
        }

        .page-content {
            padding: 30px;
            min-height: calc(100vh - 70px);
        }

        /* Profile */

        .profile-button {
            border: none;
            background: transparent;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 5px 10px;
        }

        .profile-avatar {
            width: 38px;
            height: 38px;
            min-width: 38px;
            border-radius: 50%;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .profile-avatar-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 50%;
        }

        .profile-menu {
            width: 285px;
            padding: 15px;
            border: none;
            border-radius: 10px;
        }

        .profile-details {
            border-bottom: 1px solid #e5e7eb;
            padding-bottom: 12px;
            margin-bottom: 12px;
        }

        .profile-meta {
            font-size: 12px;
            color: #64748b;
            margin-top: 7px;
        }

        /* Module cards */

        .module-card {
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 25px;
            min-height: 250px;
            display: flex;
            flex-direction: column;
            transition: transform .2s, box-shadow .2s;
        }

            .module-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 8px 25px rgba(0,0,0,.07);
            }

        .module-icon {
            width: 50px;
            height: 50px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
        }

        .audit-icon {
            background: #e8efff;
            color: #2563eb;
        }

        .notification-icon {
            background: #fff3df;
            color: #d97706;
        }

        /* Global loader */

        .optic-loader {
            position: fixed;
            inset: 0;
            background: rgba(248,250,252,.88);
            backdrop-filter: blur(5px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            opacity: 0;
            visibility: hidden;
            transition: opacity .2s ease, visibility .2s ease;
        }

            .optic-loader.active {
                opacity: 1;
                visibility: visible;
            }

        .loader-content {
            text-align: center;
            width: 220px;
        }

        .loader-logo {
            width: 65px;
            height: 65px;
            margin: 0 auto 17px;
            border-radius: 18px;
            background: var(--primary);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 31px;
            font-weight: 700;
            letter-spacing: 2px;
            box-shadow: 0 8px 25px rgba(23,37,84,.2);
            animation: opticPulse 1.5s infinite ease-in-out;
        }

        .loader-title {
            font-size: 21px;
            font-weight: 700;
            letter-spacing: 3px;
            color: var(--primary);
        }

        .loader-message {
            font-size: 12px;
            color: #64748b;
            margin-top: 6px;
        }

        .loader-track {
            height: 4px;
            width: 100%;
            background: #e2e8f0;
            border-radius: 10px;
            overflow: hidden;
            margin-top: 20px;
        }

        .loader-progress {
            width: 40%;
            height: 100%;
            background: #3b82f6;
            border-radius: 10px;
            animation: opticProgress 1.2s infinite ease-in-out;
        }

        @@keyframes opticPulse {
            0%, 100% {
                transform: scale(1);
                opacity: 1;
            }

            50% {
                transform: scale(.94);
                opacity: .8;
            }
        }

        @@keyframes opticProgress {
            0% {
                transform: translateX(-110%);
            }

            100% {
                transform: translateX(260%);
            }
        }

        /* AJAX notifications */

        .optic-toast {
            position: fixed;
            right: 25px;
            bottom: 25px;
            z-index: 10000;
            max-width: 350px;
            padding: 14px 20px;
            background: #991b1b;
            color: white;
            border-radius: 8px;
            box-shadow: 0 5px 20px rgba(0,0,0,.15);
            display: none;
        }

        /* Collapsed sidebar */

        body.sidebar-collapsed .sidebar {
            transform: translateX(-100%);
        }

        body.sidebar-collapsed .main-wrapper {
            margin-left: 0;
        }

        .sidebar-backdrop {
            display: none;
        }

        .sidebar-submenu {
            margin-left: 18px;
            padding-left: 12px;
            border-left: 1px solid rgba(255, 255, 255, 0.12);
        }

        .sidebar-sublink {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            margin: 3px 0;
            color: #aeb8c8;
            text-decoration: none;
            font-size: 13px;
            border-radius: 7px;
            transition: all 0.2s ease;
        }

            .sidebar-sublink:hover,
            .sidebar-sublink.active {
                color: #ffffff;
                background: rgba(255, 255, 255, 0.10);
            }

        @@media (max-width: 768px) {
            .sidebar {
                transform: translateX(-100%);
            }

            .main-wrapper {
                margin-left: 0;
            }

            body.mobile-sidebar-open .sidebar {
                transform: translateX(0);
            }

            body.mobile-sidebar-open .sidebar-backdrop {
                display: block;
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,.4);
                z-index: 1025;
            }

            .page-content {
                padding: 18px;
            }

            .top-header {
                padding: 0 15px;
            }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <!-- Global loading overlay -->
    <div id="opticLoader" class="optic-loader">
        <div class="loader-content">
            <div class="loader-logo">O</div>
            <div class="loader-title">OPTIC</div>
            <div class="loader-message">Preparing your workspace...</div>

            <div class="loader-track">
                <div class="loader-progress"></div>
            </div>
        </div>
    </div>

    <div id="opticToast" class="optic-toast" role="alert"></div>

    <!-- Sidebar -->
    <aside class="sidebar">

        <div class="sidebar-brand">
            <span class="brand-name">OPTIC</span>
            <span class="brand-subtitle">ENTERPRISE</span>
        </div>

        <div class="sidebar-menu">
            <div class="menu-label">Main Menu</div>

            <a asp-controller="Dashboard"
               asp-action="Index"
               data-ajax-nav
               class="sidebar-link @(currentController == "Dashboard" ? "active" : "")">

                <i class="bi bi-grid-1x2"></i>
                <span>Dashboard</span>
            </a>

            <div class="menu-label mt-4">Modules</div>

            @foreach (var application in applications)
            {
                var isActive = !string.IsNullOrWhiteSpace(application.ModulePath)
                && Context.Request.Path.StartsWithSegments(application.ModulePath,StringComparison.OrdinalIgnoreCase);

                <a href="@application.ModulePath"
                   data-ajax-nav
                   class="sidebar-link @(isActive ? "active" : "")">

                    <i class="@application.Icon"></i>
                    <span>@application.ApplicationName</span>
                </a>



                @if (application.ApplicationCode.Equals(
                            "IDENTITY",
                            StringComparison.OrdinalIgnoreCase)
                            && isActive)
                {
                    var parentMenus = identityMenus
                    .Where(x => x.ParentMenuId == null && x.ShowInSidebar)
                    .OrderBy(x => x.DisplayOrder)
                    .ToList();
                    var currentPath = Context.Request.Path;

                    <div class="sidebar-submenu">

                        @foreach (var menu in parentMenus)
                        {
                            var childMenus = menu.Children
                            .Where(x => x.ShowInSidebar)
                            .OrderBy(x => x.DisplayOrder)
                            .ToList();

                            var isRoleManagement = menu.MenuCode.Equals(
                            "ROLE_MANAGEMENT",
                            StringComparison.OrdinalIgnoreCase);

                            var isRoleSectionActive = isRoleManagement &&
                            currentPath.StartsWithSegments(
                            "/IdentityRoles",
                            StringComparison.OrdinalIgnoreCase);

                            var isMenuActive = currentPath.Equals(
                            menu.Route,
                            StringComparison.OrdinalIgnoreCase);

                            <a href="@menu.Route"
                               data-ajax-nav
                               class="sidebar-sublink @(isMenuActive || isRoleSectionActive ? "active" : "")">

                                <i class="@(menu.Icon ?? "bi bi-circle")"></i>
                                <span>@menu.MenuName</span>
                            </a>

                            @if (isRoleManagement && childMenus.Any())
                            {
                                <div class="sidebar-submenu" style="@(isRoleSectionActive ? "" : "display:none;")">

                                    @foreach (var child in childMenus)
                                    {
                                        var isChildActive = currentPath.Equals(
                                        child.Route,
                                        StringComparison.OrdinalIgnoreCase);

                                        <a href="@child.Route"
                                           data-ajax-nav
                                           class="sidebar-sublink @(isChildActive ? "active" : "")">

                                            <i class="@(child.Icon ?? "bi bi-circle")"></i>
                                            <span>@child.MenuName</span>
                                        </a>
                                    }

                                </div>
                            }
                        }

                    </div>
                }


            }

        </div>
    </aside>

    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <!-- Main wrapper -->
    <div class="main-wrapper">

        <!-- Header -->
        <header class="top-header">

            <div class="d-flex align-items-center gap-3">

                <button type="button"
                        class="sidebar-toggle"
                        id="sidebarToggle"
                        aria-label="Toggle sidebar">

                    <i class="bi bi-list"></i>
                </button>

                <h5 class="mb-0 fw-semibold" id="pageTitle">
                    @pageTitle
                </h5>

            </div>

            <!-- Profile dropdown -->
            <div class="dropdown">

                @if (User.Identity?.IsAuthenticated == true && hasSessionExpiry)
                {
                    <span id="opticSessionCountdown"
                          class="badge bg-warning text-dark optic-session-countdown"
                          data-expiry-unix-ms="@sessionExpiryUnixMs"
                          data-server-now-unix-ms="@serverNowUnixMs"
                          role="timer"
                          aria-label="Session expiry countdown">
                        Session expires in 20:00
                    </span>
                }

                <button class="profile-button"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false">

                    <div class="profile-avatar">
                        @if (!string.IsNullOrWhiteSpace(avatarUrl))
                        {
                            <img src="@avatarUrl"
                                 alt="@fullName"
                                 class="profile-avatar-image" />
                        }
                        else
                        {
                            @fullName.Substring(0, 1).ToUpper()
                        }
                    </div>

                    <div class="text-start d-none d-sm-block">
                        <div class="fw-semibold small">@fullName</div>

                        <div class="text-muted" style="font-size:11px">
                            @username
                        </div>
                    </div>

                    <i class="bi bi-chevron-down small"></i>
                </button>

                <div class="dropdown-menu dropdown-menu-end profile-menu shadow">

                    <div class="profile-details">
                        <div class="profile-meta">
                            <i class="bi bi-clock me-1"></i>
                            Session expires: @expiryText
                        </div>

                    </div>

                    <a href="#" class="dropdown-item">
                        <i class="bi bi-person me-2"></i>
                        My Profile
                    </a>

                    <a href="#" class="dropdown-item">
                        <i class="bi bi-gear me-2"></i>
                        Settings
                    </a>

                    <hr class="dropdown-divider" />

                    <!-- Logout deliberately remains a normal form -->
                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="dropdown-item text-danger">

                            <i class="bi bi-box-arrow-right me-2"></i>
                            Logout

                        </button>
                    </form>

                </div>

            </div>

        </header>

        <!-- AJAX content gets replaced here -->
        <main class="page-content" id="main-content">
            @RenderBody()
        </main>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/optic.ajax.js" asp-append-version="true"></script>
    <script src="~/js/users.js" asp-append-version="true"></script>
    <script src="~/js/userroles.js" asp-append-version="true"></script>
    <script src="~/js/applicationmappings.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>