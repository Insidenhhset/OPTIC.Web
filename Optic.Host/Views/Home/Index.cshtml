@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-header mb-4">
    <div>
        <h2 class="fw-bold mb-1">Dashboard</h2>
        <p class="text-muted mb-0">
            Welcome to Optic. Select a module to continue.
        </p>
    </div>
</div>

<div class="row g-4">

    <!-- Audit Trail Module -->
    <div class="col-md-6 col-lg-4">
        <div class="module-card h-100">
            <div class="module-icon audit-icon">
                <i class="bi bi-journal-text"></i>
            </div>

            <h5 class="fw-bold mt-3">Audit Trail</h5>

            <p class="text-muted">
                Track user activities, monitor system changes
                and maintain application audit records.
            </p>

            <a href="/Audit/Index"
               class="btn btn-outline-primary mt-auto">
                Open Module <i class="bi bi-arrow-right ms-2"></i>
            </a>
        </div>
    </div>

    <!-- Notification Module -->
    <div class="col-md-6 col-lg-4">
        <div class="module-card h-100">
            <div class="module-icon notification-icon">
                <i class="bi bi-bell"></i>
            </div>

            <h5 class="fw-bold mt-3">Notification</h5>

            <p class="text-muted">
                Manage email notifications, SMS alerts
                and notification templates.
            </p>

            <a href="/Notification/Index"
               class="btn btn-outline-primary mt-auto">
                Open Module <i class="bi bi-arrow-right ms-2"></i>
            </a>
        </div>
    </div>

</div>